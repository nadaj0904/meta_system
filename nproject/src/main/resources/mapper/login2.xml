<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.nproject.mapper.LoginMapper">

    <select id="login" resultType="com.example.nproject.dto.UserDto">
        SELECT 
            user_id as id,
            user_name as name,
            '' as email
        FROM meta_user
        WHERE user_id = #{userId}
          AND password = #{password}
    </select>

</mapper>
